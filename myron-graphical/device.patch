+MYRON_BACKBOARD_ENV = r'''/* The 24A446 CPU renderer can present hosted layers synchronously. Select
+ * that path for the display server before QuartzCore initializes its options. */
+static __attribute__((noinline)) int
+myron_backboard_display_env(struct image_params *imgp, int ptr_size)
+{
+	static const char setting[] = "CA_DISABLE_ASYNCHRONOUS=1";
+	if (strcmp(imgp->ip_strings, EXECUTABLE_KEY "/usr/libexec/backboardd") != 0) {
+		return 0;
+	}
+
+	/* The original env strings have already been copied, including their NULs. */
+	for (const char *p = imgp->ip_endargv; p < imgp->ip_strendp; p += strlen(p) + 1) {
+		if (strncmp(p, setting, sizeof(setting) - 2) == 0) {
+			return 0;
+		}
+	}
+
+	/* Leave space for the new pointer, the terminating pointer and alignment.
+	 * Near NCARGS, preserve the original exec and its original size checks. */
+	if (imgp->ip_argspace < (int)sizeof(setting) + 3 * ptr_size - 1) {
+		return 0;
+	}
+	int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(setting), UIO_SYSSPACE, TRUE);
+	if (!error) {
+		imgp->ip_argspace -= ptr_size;
+		imgp->ip_envc++;
+	}
+	return error;
+}
