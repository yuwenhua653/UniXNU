+    def test_marker_shares_only_zero_padding_and_ends_on_page_boundary(self):
+        layout = self.marker_layout()
+        original = [dict(s) for s in layout.native.segments]
+        self.assertTrue(layout.pack_constant_marker())
+        self.assertTrue(layout.shared_constant_page)
+        self.assertEqual(layout.segment('__DATA_CONST')['size'], 0x1ff8)
+        self.assertEqual(layout.segment('__LASTDATA_CONST')['size'], 8)
+        self.assertEqual(layout.native.segments, original)
+        layout.placements['__LASTDATA_CONST'] = layout.end('__DATA_CONST')
+        self.assertEqual(layout.end('__LASTDATA_CONST') % 4096, 0)
+        self.assertEqual(layout.translate(0x300000), layout.end('__DATA_CONST'))
+        # The page-granular DATA_CONST protection covers the marker's page;
+        # XNU's PLK_DATA_CONST starts on the following full page.
+        self.assertEqual((layout.end('__DATA_CONST') + 4095) & ~4095,
+                         layout.end('__LASTDATA_CONST'))
