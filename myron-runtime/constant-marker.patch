+    def marker_layout(self):
+        layout = self.padding_layout()
+        data = dict(layout.native.segments[0], command_offset=64)
+        last = dict(data, name='__LASTDATA_CONST', va=0x300000,
+                    fileoff=0x8000, command_offset=144)
+        layout.native.segments = [data, last]
+        layout.output_segments = {s['name']: dict(s) for s in (data, last)}
+        layout.native.sections.append(dict(segment=last['name'], name='__mod_init_func',
+                                           va=last['va'], size=8))
+        raw = bytearray(layout.native.data) + bytes(512)
+        for segment in (data, last):
+            struct.pack_into('<II', raw, segment['command_offset'] + 56, 1, 1)
+        struct.pack_into('<I', raw, last['command_offset'] + 124, 3)
+        struct.pack_into('<I', raw, last['command_offset'] + 136, 9)
+        layout.native.data = raw
+        layout.shared_constant_page = False
+        self.assertTrue(layout.compact_constant_tail())
+        self.assertTrue(layout.compact_constant_tail('__LASTDATA_CONST'))
