+        ordinal = sections[0][0]
+        if any(kind not in (2, 13) for kind, si, so, ti, to in split_references(self.native)
+               if si == ordinal or ti == ordinal):
+            return False
+        old_segments = dict(self.output_segments)
+        old_trim_count = len(self.constant_padding_trimmed)
+        if not (self.compact_constant_tail('__DATA_CONST', data['size'] - 8)
+                and self.compact_constant_tail('__LASTDATA_CONST', 8)):
+            self.output_segments = old_segments
+            del self.constant_padding_trimmed[old_trim_count:]
+            return False
+        self.shared_constant_page = True
+        return True
