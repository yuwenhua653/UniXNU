+    def pack_constant_marker(self):
+        """Share the final constant page with a pointer-only LASTDATA_CONST.
+
+        The marker ends on a 4 KiB boundary, so XNU's derived PLK_DATA_CONST
+        begins on a full page. Native DATA_CONST maps the shared page RW/NX
+        during initialization and RO/NX at lockdown. No retained bytes share
+        this page. Only an 8-byte initializer is supported; instruction page
+        offsets must never be changed by this fallback.
+        """
+        data = self.segment('__DATA_CONST')
+        last = self.segment('__LASTDATA_CONST')
+        sections = [(i + 1, s) for i, s in enumerate(self.native.sections)
+                    if s['segment'] == '__LASTDATA_CONST']
+        if (len(sections) != 1 or sections[0][1]['name'] != '__mod_init_func'
+                or sections[0][1]['va'] != last['va'] or sections[0][1]['size'] != 8
+                or data['size'] % NATIVE_PAGE or last['va'] % NATIVE_PAGE):
+            return False
+        # Both Mach-O mappings must declare the same RO/NX permissions. Packing
+        # applies only to the no-monitor fileset layout with pointer relocations.
+        for segment in (data, last):
+            if struct.unpack_from('<II', self.native.data, segment['command_offset'] + 56) != (1, 1):
+                return False
+        section_at = last['command_offset'] + 72
+        if (struct.unpack_from('<I', self.native.data, section_at + 52)[0] > 3
+                or struct.unpack_from('<I', self.native.data, section_at + 64)[0] & 0xff != 9):
