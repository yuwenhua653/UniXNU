+    def test_marker_rejects_sections_permissions_alignment_and_instruction_refs(self):
+        for mode in ('section', 'size', 'permissions', 'alignment', 'flags', 'instruction'):
+            with self.subTest(mode=mode):
+                layout = self.marker_layout()
+                if mode == 'section': layout.native.sections[-1]['name'] = '__pinst'
+                if mode == 'size': layout.native.sections[-1]['size'] = 16
+                if mode == 'permissions': struct.pack_into('<I', layout.native.data, 144+56, 3)
+                if mode == 'alignment': struct.pack_into('<I', layout.native.data, 144+124, 4)
+                if mode == 'flags': struct.pack_into('<I', layout.native.data, 144+136, 0)
+                if mode == 'instruction':
+                    blob = records([(1, 2, [(0, [(6, [0])])])])
+                    layout.native.data[16:16+len(blob)] = blob
+                    struct.pack_into('<I', layout.native.data, 12, len(blob))
+                before = {n: dict(s) for n, s in layout.output_segments.items()}
+                self.assertFalse(layout.pack_constant_marker())
+                self.assertEqual(layout.output_segments, before)
+                self.assertFalse(layout.shared_constant_page)
