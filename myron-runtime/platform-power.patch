+// Called only by the normal platform shutdown/restart boundary, after XNU
+// has flushed storage and delivered its power notifications. No PMIC register
+// guesses and no firmware call while parsing the device tree.
+static int platformPowerCall (bool hvc, uint32_t function)
+{
+  register uint64_t x0 __asm__ ("x0") = function;
+  register uint64_t x1 __asm__ ("x1") = 0;
+  register uint64_t x2 __asm__ ("x2") = 0;
+  register uint64_t x3 __asm__ ("x3") = 0;
+  if (hvc) {
+    __asm__ volatile ("hvc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+      "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+  } else {
+    __asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+      "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+  }
+  // SYSTEM_OFF/RESET do not return on success. A returning firmware, even
+  // one returning zero, must not be reported as a completed power transition.
+  return (int32_t)x0 ? (int32_t)x0 : -1;
+}
+
+int ArmDTPlatform::haltRestart (unsigned int type)
+{
+  static_assert(kPEHaltCPU == 0 && kPERestartCPU == 1 && kPEUPSDelayHaltCPU == 3,
+                "Unexpected platform power ABI");
+  uint32_t function = 0;
+  if (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU) function = 0x84000008u;
+  else if (type == kPERestartCPU) function = 0x84000009u;
+  else return IODTPlatformExpert::haltRestart(type);
+  if (!psciKnown) return -1;
+  // The conduit was copied during configure; shutdown does not walk IORegistry
+  // or allocate memory after devices and their work loops have stopped.
+  return platformPowerCall(psciHvc, function);
+}
+
 bool ArmDTPlatform::configure (IOService *provider)
 {
+  IORegistryEntry *psci = provider->childFromPath("psci", gIODTPlane);
+  if (psci) {
+    OSData *method = OSDynamicCast(OSData, psci->getProperty("method"));
+    if (method && method->getLength() == 4) {
+      const void *bytes = method->getBytesNoCopy();
+      if (!memcmp(bytes, "smc", 4)) { psciKnown = true; psciHvc = false; }
+      else if (!memcmp(bytes, "hvc", 4)) { psciKnown = true; psciHvc = true; }
+    }
+    psci->release();
+  }
   IORegistryEntry *cpus = provider->childFromPath ("cpus", gIODTPlane);
   IORegistryEntry *bus = provider->childFromPath ("arm-io", gIODTPlane);
   IORegistryEntry *defaults = provider->childFromPath ("defaults", gIODTPlane);
