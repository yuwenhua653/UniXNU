+def check_setup_seed(packed):
+    """Check the logical geometry delivered to RamBlock and the APFS container inside."""
+    require(len(packed) >= 48, 'Truncated Setup Data seed')
+    magic, version, block, logical, runs = struct.unpack_from('<8sIIQQ', packed)
+    require((magic, version, block) == (b'DBRDISK1', 1, 4096) and
+            SETUP_MIN_MIB*MIB <= logical <= data_seed.MAX_LOGICAL,
+            'Wrong packed Setup Data capacity or format')
+    body = 32 + runs * 16
+    require(0 < runs <= 65536 and body+block <= len(packed), 'Missing packed Setup Data extents')
+    offset, size = struct.unpack_from('<QQ', packed, 32)
+    require(offset == 0 and block <= size <= len(packed)-body and packed[body+32:body+36] == b'NXSB',
+            'Packed Setup Data has no APFS container at block zero')
+    block_size, blocks = struct.unpack_from('<IQ', packed, body+36)
+    require(block_size == block and blocks*block_size == logical, 'Packed and APFS Data capacities differ')
+    return logical
 
 
