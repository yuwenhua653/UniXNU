+def desktop_preferences():
+    """Upstream Skip Setup preferences for a new, owned 24A446 installation.
+
+    Applied only while copying the signed donor's initial /private/var into a
+    new local Data volume. Keep the native watchdogs: upstream's optional
+    BKNoWatchdogs/FBLaunchWatchdogExceptions are not needed to complete Setup.
+    """
+    require((BUILD, VERSION) == ('24A446', '27.0.1'), 'Skip Setup requires reviewed 24A446 values')
+    return {
+        'com.apple.purplebuddy': dict(SetupDone=True, SetupFinishedAllSteps=True,
+            SetupVersion=11, daemonizeNeedsToRun=False),
+        'com.apple.purplebuddy.notbackedup': dict.fromkeys((
+            'ShouldRunDiagnosticsMiniBuddy', 'ShouldRunHSA2MiniBuddy',
+            'ShouldRunKeychainSyncMiniBuddy', 'ShouldRunMesaMiniBuddy',
+            'ShouldRunPaymentMiniBuddy', 'ShouldRunStandardMiniBuddy', 'SilentICDPUpgrade'), False),
+        'com.apple.managedconfiguration.notbackedup': {
+            'LockdownActivationIndicatesCloudConfigurationAvailable': False},
+        'com.apple.springboard': dict(MCForceShowCloudConfigurationUI=False,
+            SBDisableAutoDim=True, SBDontDimOrLockOnAC=True, SBDisableIdleSleep=True),
+        'com.apple.migration': dict(LastSystemVersion=BUILD,
+            DMUserDataDisposition=dict(SyntheticDidUpgrade=False, buildVersion=BUILD)),
+    }
+
+
+def desktop_preference_path(root, domain):
+    path = Path(root)
+    for name in ('mobile', 'Library', 'Preferences'):
+        path /= name
+        require(not path.is_symlink() and path.is_dir(), 'Invalid mobile preferences directory')
+    path /= domain + '.plist'
+    require(not path.is_symlink() and (not path.exists() or path.is_file()),
+            'Invalid Setup preferences file: ' + domain)
+    return path
+
+
+def set_desktop_preferences(root):
+    for domain, values in desktop_preferences().items():
+        path = desktop_preference_path(root, domain)
+        exists = path.exists()
+        content = plistlib.loads(path.read_bytes()) if exists else {}
+        require(isinstance(content, dict), 'Expected Setup preferences dictionary: ' + domain)
+        content.update(values)
+        path.write_bytes(plistlib.dumps(content, fmt=plistlib.FMT_BINARY))
+        # Preferences belong to the mobile account that reads them. No ACL or
+        # extended-attribute stripping, and no modification of the donor mount.
+        os.chown(path, 501, 501)
+        path.chmod(0o600)
+    return check_desktop_preferences(root)
+
+
+def check_desktop_preferences(root):
+    hashes = {}
+    for domain, values in desktop_preferences().items():
+        path = desktop_preference_path(root, domain)
+        content = plistlib.loads(path.read_bytes())
+        require(isinstance(content, dict), 'Expected Setup preferences dictionary: ' + domain)
+        # Typed plist equality rejects integer/string stand-ins for booleans.
+        actual = {key: content[key] for key in values if key in content}
+        require(plistlib.dumps(actual) == plistlib.dumps(values), 'Wrong desktop seed values: ' + domain)
+        st = path.stat()
+        require((st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) == (501, 501, 0o600),
+                'Wrong desktop seed ownership/mode: ' + domain)
+        hashes[domain] = sha(path)
+    return dict(policy=SETUP_POLICY, skip_setup=True, build=BUILD, version=VERSION,
+                no_auto_dim=True, preferences_sha256=hashes,
+                watchdog_bypass_added=False, phone_tested=False)
 
 
