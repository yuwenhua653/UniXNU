 / {
     model = "Xiaomi Redmi K90 Pro Max (myron)";
     compatible = "xiaomi,myron", "qcom,sm8850";
+    // The myron Android board enumerates this radio as qcom,cnss-peach.
+    // Publish its identity before launchd evaluates the stock wifid job.
+    wlan {
+        compatible = "qcom,cnss-peach";
+        unixnu,adt-name = "wlan";
+        status = "okay";
+    };
+
     // Preserve R90's window. Firmware must still validate FDT/EFI/GCD/GOP
     // exclusions before publishing this memory to a new kernel.
     memory@8c0000000 {
